# exchange-core-lab — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored (SPEC §1.3).
# This file must only ever contain placeholder strings — never a real key,
# and never a value shaped like a real key.

# --- Exchange credentials ---------------------------------------------------
# Binance SPOT TESTNET only. Get a testnet key pair from the testnet portal.
# Mainnet credentials are rejected by design: the base URL allowlist (§1.4)
# refuses to start against any non-testnet host, and there is no override.
BINANCE_TESTNET_API_KEY=REPLACE_WITH_BINANCE_TESTNET_API_KEY
BINANCE_TESTNET_API_SECRET=REPLACE_WITH_BINANCE_TESTNET_API_SECRET

# --- Local infrastructure ---------------------------------------------------
# Local development only. Not a production credential.
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DEV_PASSWORD

# The application connects as a separate, non-superuser role; the owner above is used only for
# migrations. Keeping them apart is what makes the revoked UPDATE/DELETE grants on postings bite.
APP_DB_PASSWORD=REPLACE_WITH_LOCAL_DEV_PASSWORD
